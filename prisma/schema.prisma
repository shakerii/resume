generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model BasicInfo {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  company     Json
  role        Json
  period      Json?
  description Json?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id           String              @id @default(cuid())
  slug         String              @unique
  title        Json
  excerpt      Json?
  content      Json
  technologies ProjectTechnology[]
  active       Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProjectTechnology {
  id        String  @id @default(cuid())
  name      Json
  sortOrder Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model SkillGroup {
  id        String   @id @default(cuid())
  name      Json
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        String     @id @default(cuid())
  name      Json
  rating    Int        @default(5)
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  groupId   String
  group     SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Education {
  id          String   @id @default(cuid())
  degree      Json
  institution Json?
  period      Json?
  description Json?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Language {
  id        String   @id @default(cuid())
  name      Json
  level     Json?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnalyticsLog {
  id         String   @id
  createdAt  DateTime @default(now())
  visitorId  String
  sessionId  String
  type       String
  path       String
  source     String
  referrer   String?
  medium     String?
  campaign   String?
  target     String?
  value      Float?
  durationMs Int      @default(0)

  @@index([createdAt])
  @@index([sessionId, createdAt])
  @@index([path, createdAt])
}
